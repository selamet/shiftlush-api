# Copy to .env for local development. .env is never committed.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Left unset locally: the default is SQLite, so nothing has to be running.
# Production sets this to the PostgreSQL instance.
# DATABASE_URL=postgres://user:password@host:5432/shiftlush

# Left unset locally too: the cache falls back to memory, so nothing has to be
# running. Two endpoints in production, because `maxmemory-policy` belongs to
# the Redis server and not to the numbered database: :6379 evicts under memory
# pressure (caches), :6380 never evicts (queues). Keys are namespaced with the
# `shiftlush:` prefix — the shared server's ACL refuses anything else.
# REDIS_URL=rediss://shiftlush:password@redis.selamet.dev:6379/0
# REDIS_QUEUE_URL=rediss://shiftlush:password@redis.selamet.dev:6380/0

# Field-level encryption for national ID numbers. In production this comes from
# a secret manager, never from a file.
FIELD_ENCRYPTION_KEY=

# Object storage. Which backend new uploads go to: `local` (MinIO) here, `r2`
# in production. Files already uploaded keep the backend recorded on their row,
# so changing this does not strand them.
STORAGE_BACKEND=local

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=shiftlush
S3_SECRET_ACCESS_KEY=shiftlush123
S3_BUCKET_NAME=shiftlush-dev

# Production only. The bucket's jurisdiction is pinned to the EU when it is
# created and cannot be changed afterwards — see the KVKK decision in the
# specification. Remember the CORS rule on the bucket, or browser uploads fail
# with a message that mentions neither CORS nor the bucket.
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Reverse geocoding for the map address picker. Nominatim's usage policy wants a
# User-Agent that says who is sending the traffic and how to reach them, and
# blocks requests that arrive without one — so this is not decoration. The same
# policy caps traffic at one request a second, which is what the response cache
# and GEOCODING_RATE_LIMIT are for. Running our own instance, or moving to a
# commercial provider, is a change to GEOCODING_URL and nothing else.
# GEOCODING_USER_AGENT=ShiftLush/1.0 (+https://shiftlush.selamet.dev)
# GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
# GEOCODING_RATE_LIMIT=60/min

# Request limits (8.13). The defaults are what the specification asks for; they
# are settable so a deployment under load can be widened without a release. The
# counter lives in the cache, so with REDIS_URL unset it is per-process — three
# gunicorn workers would each allow the configured number, which is the one
# thing about these two worth remembering.
# ANON_RATE_LIMIT=20/min
# USER_RATE_LIMIT=300/min

# How many proxies of our own stand in front of the application, and therefore
# how many X-Forwarded-For entries can be believed. Zero here: nothing is in
# front locally, so that header — if a caller sends one — is the caller's own
# writing. Production sets one, for Caddy. Too high and a forged header buys a
# fresh rate limit bucket per request and writes an invented address into the
# audit log; too low and every caller shares one bucket. See core/client_ip.py.
# TRUSTED_PROXY_COUNT=0

# How often one signed-in user may call POST /auth/password. The endpoint says
# whether a guess at the current password was right, so unthrottled it is a
# guessing oracle for anybody holding a stolen access token. The login lockout
# does not cover it — that counts failures against a sign-in, and this caller is
# already signed in. Lower it if you like; raising it is the decision to think
# about.
# PASSWORD_CHANGE_RATE_LIMIT=10/hour

# Where the frontend is served. Every e-mail links into it, so this is mail
# configuration, not just a CORS entry.
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=ShiftLush <noreply@shiftlush.local>

# Production only. Development prints mail to the console instead.
# The scheme selects TLS. `smtp+tls://` is STARTTLS on 587; `smtp+ssl://` is
# implicit TLS on 465. A `?tls=True` query parameter is ignored — production
# refuses to boot without one of these schemes, because SMTP AUTH over an
# unencrypted session sends the password in clear text.
# EMAIL_URL=smtp+tls://user:password@smtp.provider.com:587

# ---------------------------------------------------------------------------
# Production only. These live in /opt/apps/shiftlush-api/.env on the VDS and
# are never committed. Every one of them is required: production settings read
# them with no default so a missing secret stops the process at boot rather
# than falling back to something insecure.
# ---------------------------------------------------------------------------
# DJANGO_ALLOWED_HOSTS=shiftlush-api.selamet.dev
# CORS_ALLOWED_ORIGINS=https://shiftlush.selamet.dev
# CSRF_TRUSTED_ORIGINS=https://shiftlush.selamet.dev
# DATABASE_URL=postgresql://shiftlush_app:...@database.selamet.dev:5432/shiftlush?sslmode=verify-full
# REDIS_URL=rediss://shiftlush:...@redis.selamet.dev:6379/0
# Read by nothing yet; set it now so adding background work does not mean
# touching the server's environment again.
# REDIS_QUEUE_URL=rediss://shiftlush:...@redis.selamet.dev:6380/0

# Error reporting. Unset locally and in the test suite on purpose: a developer's
# mistakes are not production incidents, and a test run reporting its own
# deliberate failures would bury the real ones.
#
# What is sent is deliberately narrow -- see core/observability.py. The request
# body is never collected: a validation failure on the customer form carries a
# national identity number, which the database encrypts at rest and which has no
# business in an error report. Sentry's own example enables that collection;
# this deployment does not.
# SENTRY_DSN=https://...@...ingest.de.sentry.io/...
# SENTRY_ENVIRONMENT=production
# Stamped on every event so a regression points at the deploy that caused it.
# SENTRY_RELEASE=
# Performance tracing samples ordinary requests, not errors, so it spends quota
# continuously to answer a question nobody has asked yet.
# SENTRY_TRACES_SAMPLE_RATE=0.0
